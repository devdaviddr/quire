# Copy to .env and fill in. Docker Compose reads this file automatically.

# Required only for the contextual detector (pipeline stage 3c).
# Every other stage runs offline.
ANTHROPIC_API_KEY=

# Model used for context-dependent span detection.
QUIRE_MODEL=claude-opus-5

# Host port the API binds to. Change it if 8000 is already taken.
QUIRE_PORT=8000

# The following are set by docker-compose.yml and listed here for reference —
# override them only if you are running the API outside Compose.
# DATABASE_URL=postgresql+psycopg://quire:quire@db:5432/quire
# QUIRE_DATA_DIR=/data
