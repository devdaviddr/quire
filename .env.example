# Copy to .env and fill in. Docker Compose reads this file automatically.

# --- Contextual detector (pipeline stage 3c) -------------------------------
# The only stage that leaves this machine. Every other stage runs offline.
# Free key from https://build.nvidia.com — rate-limited, not token-billed.
NVIDIA_API_KEY=

# Fastest of the nemotron-3 family in practice (~7-10s/page). Nano is slower
# despite being smaller because it is far more verbose; ultra is ~59s/page and
# unusable per-page. See docs/model-notes.md.
QUIRE_LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
QUIRE_LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# Free endpoints are rate-limited, so throughput is the constraint. Raise only
# if your key tolerates it; back off on 429.
QUIRE_LLM_CONCURRENCY=4

# --- Fully local alternative ------------------------------------------------
# Any OpenAI-compatible server works; only the base URL and model change.
# QUIRE_LLM_BASE_URL=http://host.docker.internal:11434/v1   # Ollama
# QUIRE_LLM_MODEL=gpt-oss
# NVIDIA_API_KEY=unused

# --- Ports ------------------------------------------------------------------
QUIRE_API_PORT=8000
QUIRE_WEB_PORT=5173

# Set by docker-compose.yml; override only when running outside Compose.
# DATABASE_URL=postgresql+psycopg://quire:quire@db:5432/quire
# QUIRE_DATA_DIR=/data
